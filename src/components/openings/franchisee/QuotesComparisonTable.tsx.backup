'use client';

import { useState } from 'react';
import { Quote } from '@/types/openings';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { 
  CheckCircle2, 
  Award, 
  Download, 
  TrendingDown,
  Calendar,
  Shield,
  CreditCard,
  FileText,
  X,
} from 'lucide-react';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from '@/components/ui/dialog';
import {
  Tooltip,
  TooltipContent,
  TooltipProvider,
  TooltipTrigger,
} from '@/components/ui/tooltip';

interface QuotesComparisonTableProps {
  categoryId: string;
  categoryName: string;
  categoryDescription?: string;
  budgetEstimate: number;
  quotes: Quote[];
  onAward: (quoteId: string) => Promise<void>;
  onRevert?: (quoteId: string) => Promise<void>;
  isAwarding?: boolean;
}

export function QuotesComparisonTable({
  categoryId,
  categoryName,
  categoryDescription,
  budgetEstimate,
  quotes,
  onAward,
  onRevert,
  isAwarding = false,
}: QuotesComparisonTableProps) {
  const [selectedQuote, setSelectedQuote] = useState<Quote | null>(null);
  const [showConfirmDialog, setShowConfirmDialog] = useState(false);
  const [showRevertDialog, setShowRevertDialog] = useState(false);
  const [actionType, setActionType] = useState<'award' | 'revert'>('award');

  // Encontrar el presupuesto más barato
  const lowestAmount = quotes.length > 0 
    ? Math.min(...quotes.map(q => q.amount))
    : 0;

  // Encontrar el presupuesto ya adjudicado (si existe)
  const awardedQuote = quotes.find(q => q.status === 'awarded');
ActionType('award');
    setShowConfirmDialog(true);
  };

  const handleRevertClick = (quote: Quote) => {
    setSelectedQuote(quote);
    setActionType('revert');
    setShowRevertDialog(true);
  };

  const handleConfirmAward = async () => {
    if (selectedQuote) {
      await onAward(selectedQuote.id);
      setShowConfirmDialog(false);
      setSelectedQuote(null);
    }
  };

  const handleConfirmRevert = async () => {
    if (selectedQuote && onRevert) {
      await onRevert(selectedQuote.id);
      setShowRevertmAward = async () => {
    if (selectedQuote) {
      await onAward(selectedQuote.id);
      setShowConfirmDialog(false);
      setSelectedQuote(null);
    }
  };

  const formatCurrency = (cents: number) => {
    return new Intl.NumberFormat('es-ES', {
      style: 'currency',
      currency: 'EUR',
    }).format(cents / 100);
  };

  const getSavingsPercentage = (amount: number) => {
    if (budgetEstimate === 0) return 0;
    const savings = ((budgetEstimate - amount) / budgetEstimate) * 100;
    return Math.round(savings * 10) / 10;
  };

  if (quotes.length === 0) {
    return (
      <Card>
        <CardHeader>
          <CardTitle>Comparación de Presupuestos</CardTitle>
          <CardDescription>{categoryName}</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="text-center py-12">
            <FileText className="h-12 w-12 text-gray-400 mx-auto mb-4" />
            <h3 className="text-lg font-semibold text-gray-900 mb-2">
              No hay presupuestos recibidos
            </h3>
            <p className="text-gray-600">
              Aún no se han recibido presupuestos para esta categoría.
            </p>
          </div>
        </CardContent>
      </Card>
    );
  }

  return (
    <>
      <Card>
        <CardHeader>
          <div className="flex items-start justify-between">
            <div>
              <CardTitle>Comparación de Presupuestos</CardTitle>
              <CardDescription className="mt-1">
                {categoryName}
                {categoryDescription && (
                  <span className="block text-sm text-gray-500 mt-1">
                    {categoryDescription}
                  </span>
                )}
              </CardDescription>
            </div>
            <div className="text-right">
              <p className="text-sm text-gray-600">Presupuesto estimado</p>
              <p className="text-2xl font-bold text-gray-900">
                {formatCurrency(budgetEstimate)}
              </p>
            </div>
          </div>

          {/* Estadísticas */}
          <div className="grid grid-cols-3 gap-4 mt-6">
            <div className="bg-blue-50 rounded-lg p-3">
              <p className="text-sm text-blue-600 font-medium">
                Presupuestos recibidos
              </p>
              <p className="text-2xl font-bold text-blue-900">
                {quotes.length}
              </p>
            </div>
            <div className="bg-green-50 rounded-lg p-3">
              <p className="text-sm text-green-600 font-medium flex items-center gap-1">
                <TrendingDown className="h-4 w-4" />
                Mejor oferta
              </p>
              <p className="text-2xl font-bold text-green-900">
                {formatCurrency(lowestAmount)}
              </p>
            </div>
            <div className="bg-purple-50 rounded-lg p-3">
              <p className="text-sm text-purple-600 font-medium">
                Ahorro potencial
              </p>
              <p className="text-2xl font-bold text-purple-900">
                {getSavingsPercentage(lowestAmount) > 0 ? '+' : ''}
                {getSavingsPercentage(lowestAmount)}%
              </p>
            </div>
          </div>
        </CardHeader>

        <CardContent>
          <div className="overflow-x-auto">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead className="w-[200px]">Proveedor</TableHead>
                  <TableHead>Importe</TableHead>
                  <TableHead>Plazo</TableHead>
                  <TableHead>Garantía</TableHead>
                  <TableHead>Condiciones de Pago</TableHead>
                  <TableHead>PDF</TableHead>
                  <TableHead>Estado</TableHead>
                  <TableHead className="text-right">Acción</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {quotes.map((quote) => {
                  const isLowest = quote.amount === lowestAmount;
                  const isAwarded = quote.status === 'awarded';
                  const savings = getSavingsPercentage(quote.amount);

                  return (
                    <TableRow 
                      key={quote.id}
                      className={isLowest ? 'bg-green-50' : ''}
                    >
                      {/* Proveedor */}
                      <TableCell className="font-medium">
                        <div>
                          <p className="font-semibold text-gray-900">
                            {quote.supplier?.name || 'Proveedor'}
                          </p>
                          {quote.supplier?.email && (
                            <p className="text-xs text-gray-500">
                              {quote.supplier.email}
                            </p>
                          )}
                          {quote.supplier?.phone && (
                            <p className="text-xs text-gray-500">
                              {quote.supplier.phone}
                            </p>
                          )}
                        </div>
                      </TableCell>

                      {/* Importe */}
                      <TableCell>
                        <div className="flex flex-col">
                          <span className="text-lg font-bold text-gray-900">
                            {formatCurrency(quote.amount)}
                          </span>
                          {isLowest && (
                            <Badge variant="default" className="w-fit mt-1 bg-green-600">
                              <TrendingDown className="h-3 w-3 mr-1" />
                              Mejor precio
                            </Badge>
                          )}
                          {savings !== 0 && (
                            <span className={`text-xs mt-1 ${savings > 0 ? 'text-green-600' : 'text-red-600'}`}>
                              {savings > 0 ? '↓' : '↑'} {Math.abs(savings)}% vs estimado
                            </span>
                          )}
                        </div>
                      </TableCell>

                      {/* Plazo */}
                      <TableCell>
                        <div className="flex items-center gap-2">
                        {quote.payment_terms ? (
                          <TooltipProvider>
                            <Tooltip>
                              <TooltipTrigger asChild>
                                <div className="flex items-center gap-2 max-w-[200px]">
                                  <CreditCard className="h-4 w-4 text-gray-500 flex-shrink-0" />
                                  <span className="text-sm truncate">
                                    {quote.payment_terms}
                                  </span>
                                </div>
                              </TooltipTrigger>
                              <TooltipContent className="max-w-xs">
                                <p>{quote.payment_terms}</p>
                              </TooltipContent>
                            </Tooltip>
                          </TooltipProvider>
                        ) : (
                          <span className="text-sm text-gray-400">-</span>
                        )}ntía */}
                      <TableCell>
                        <div className="flex items-center gap-2">
                          <Shield className="h-4 w-4 text-gray-500" />
                          <span>{quote.warranty_months || 0} meses</span>
                        </div>
                      </TableCell>

                      {/* Condiciones de pago */}
                      <TableCell>
                        <div className="flex items-center gap-2 max-w-[200px]">
                          <CreditCard className="h-4 w-4 text-gray-500 flex-shrink-0" />
                          <span className="text-sm truncate" title={quote.payment_terms}>
                            {quote.payment_terms || '-'}
                          </span>
                        </div>
                      </TableCell>

                      {/* PDF */}
                      <TableCell>
                        {quote.pdf_url ? (
                          <Button
                            variant="ghost"
                            size="sm"
                            quote.status === 'submitted' ? (
                          <Badge variant="outline" className="border-blue-500 text-blue-700">
                            Enviado
                          </Badge>
                        ) : (
                          <Badge variant="outline">
                            Borrador
                          </Badge>
                        )}
                      </TableCell>

                      {/* Acción */}
                      <TableCell className="text-right">
                        <div className="flex gap-2 justify-end">
                          {isAwarded ? (
                            onRevert && (
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => handleRevertClick(quote)}
                                disabled={isAwarding}
                              >
                                <X className="h-4 w-4 mr-2" />
                                Revertir
                              </Button>
                            )
                          ) : !awardedQuote && quote.status === 'submitted' ? (
                            <Button
                              size="sm"
                              onClick={() => handleAwardClick(quote)}
                              disabled={isAwarding}
                              className="bg-blue-600 hover:bg-blue-700"
                            >
                              <CheckCircle2 className="h-4 w-4 mr-2" />
                              Adjudicar
                            </Button>
                          ) : null}
                        </div>sAwarded ? (
                          <Badge variant="default" className="bg-green-600">
                            <Award className="h-3 w-3 mr-1" />
                            Adjudicado
                          </Badge>
                        ) : quote.status === 'rejected' ? (
                          <Badge variant="secondary">
                            Rechazado
                          </Badge>
                        ) : (
                          <Badge variant="outline">
                            Pendiente
                          </Badge>
                        )}
                      </TableCell>

                      {/* Acción */}
                      <TableCell className="text-right">
                        {!awardedQuote && quote.status === 'submitted' && (
                          <Button
                            size="sm"
                            onClick={() => handleAwardClick(quote)}
                            disabled={isAwarding}
                            className="bg-blue-600 hover:bg-blue-700"
                          >
                            <CheckCircle2 className="h-4 w-4 mr-2" />
                            Adjudicar
                          </Button>
                        )}
                      </TableCell>
                    </TableRow>
                  );
                })}
              </TableBody>
            </Table>
          </div>

          {/* Notas adicionales */}
          {quotes.some(q => q.notes) && (
            <div className="mt-6 space-y-3">
              <h4 className="font-semibold text-gray-900">Notas de los proveedores</h4>
              {quotes.map(quote => (
                quote.notes && (
                  <div key={quote.id} className="bg-gray-50 rounded-lg p-3">
                    <p className="text-sm font-medium text-gray-900 mb-1">
                      {quote.supplier?.name || 'Proveedor'}
                    </p>
                    <p className="text-sm text-gray-700">{quote.notes}</p>
                  </div>
                )
              ))}
            </div>
          )}
        </CardContent>
      </Card>

      {/* Confirmation Dialog */}
      <Dialog open={showConfirmDialog} onOpenChange={setShowConfirmDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Confirmar Adjudicación</DialogTitle>
            <Di

      {/* Revert Dialog */}
      <Dialog open={showRevertDialog} onOpenChange={setShowRevertDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Revertir Adjudicación</DialogTitle>
            <DialogDescription>
              ¿Estás seguro de que deseas revertir la adjudicación de{' '}
              <strong>{selectedQuote?.supplier?.name}</strong>?
              {' '}El presupuesto volverá al estado "Enviado".
            </DialogDescription>
          </DialogHeader>

          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setShowRevertDialog(false)}
              disabled={isAwarding}
            >
              Cancelar
            </Button>
            <Button
              onClick={handleConfirmRevert}
              disabled={isAwarding}
              variant="destructive"
            >
              {isAwarding ? 'Revirtiendo...' : 'Confirmar Reversión'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>alogDescription>
              ¿Estás seguro de que deseas adjudicar el presupuesto a{' '}
              <strong>{selectedQuote?.supplier?.name}</strong>?
            </DialogDescription>
          </DialogHeader>

          {selectedQuote && (
            <div className="bg-gray-50 rounded-lg p-4 space-y-2">
              <div className="flex justify-between">
                <span className="text-sm text-gray-600">Importe:</span>
                <span className="font-semibold">
                  {formatCurrency(selectedQuote.amount)}
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-sm text-gray-600">Plazo de entrega:</span>
                <span className="font-semibold">
                  {selectedQuote.delivery_days} días
                </span>
              </div>
              <div className="flex justify-between">
                <span className="text-sm text-gray-600">Garantía:</span>
                <span className="font-semibold">
                  {selectedQuote.warranty_months} meses
                </span>
              </div>
            </div>
          )}

          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setShowConfirmDialog(false)}
              disabled={isAwarding}
            >
              Cancelar
            </Button>
            <Button
              onClick={handleConfirmAward}
              disabled={isAwarding}
              className="bg-blue-600 hover:bg-blue-700"
            >
              {isAwarding ? 'Adjudicando...' : 'Confirmar Adjudicación'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </>
  );
}
