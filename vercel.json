{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false,
      "feature/mock-version": false,
      "medusa-update": true
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "buildCommand": "npm run build",
  "ignoreCommand": "bash -c 'if [[ \"$VERCEL_GIT_COMMIT_REF\" == \"main\" ]]; then exit 0; else exit 1; fi'",
  "installCommand": "npm install",
  "framework": "nextjs"
}
