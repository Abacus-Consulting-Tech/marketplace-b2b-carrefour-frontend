{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false,
      "feature/mock-version": false,
      "medusa-update": true
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "buildCommand": "npm run build",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"${DEPLOY_BRANCH:-main}\" ]; then exit 1; else exit 0; fi",
  "installCommand": "npm install",
  "framework": "nextjs"
}
