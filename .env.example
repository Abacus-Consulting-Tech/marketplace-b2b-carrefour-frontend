# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_TIMEOUT=10000

# Medusa/Mercur Store API Configuration
# Local: http://localhost:9000/store
# Render DEV: https://marketplace-b2b-backend-dev.onrender.com/store
NEXT_PUBLIC_MERCUR_STORE_API=http://localhost:9000/store
NEXT_PUBLIC_MERCUR_PUBLISHABLE_API_KEY=pk_your_local_publishable_key
NEXT_PUBLIC_MERCUR_REGION_ID=reg_your_local_region_id

# Catalog and Cart Source (mercur = real backend, mock = local mock data)
NEXT_PUBLIC_CATALOG_SOURCE=mercur
NEXT_PUBLIC_CART_SOURCE=mercur

# Authentication
NEXT_PUBLIC_TOKEN_KEY=carrefour_b2b_token
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Mock Auth Mode (set to false to use real backend auth)
NEXT_PUBLIC_MOCK_AUTH=false
false
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_CATALOG_SOURCE=mock
NEXT_PUBLIC_CART_SOURCE=local

# Environment
NODE_ENV=development

# External Services
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
