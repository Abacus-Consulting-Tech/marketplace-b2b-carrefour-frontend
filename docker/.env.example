# =============================================================================
# Plantilla de .env para docker/compose.yml. SOLO placeholders.
#
#   DESPLIEGUE: /opt/projects/marketplace-b2b-carrefour-frontend/.env
#   (en local el front corre en el host: npm run dev -- -p 3100, con
#    NEXT_PUBLIC_API_URL=http://localhost:9001 en .env.local)
# =============================================================================

# Imagen a desplegar. El workflow de deploy la actualiza con sed en cada deploy.
IMAGE_FRONT=ghcr.io/ORG/marketplace-b2b-carrefour-frontend:pre-0000000

# Puerto en 127.0.0.1 del host al que apunta el proxy inverso (app -> 3000 interno).
FRONT_PUBLISH_PORT=3100

# --- Build args (horneadas en la imagen; cambiarlas = reconstruir) ------------
# URL PUBLICA del backend Medusa, alcanzable desde el NAVEGADOR del usuario
# (las llamadas salen del browser, no del contenedor). Sin ella el front
# arranca en modo mock.
NEXT_PUBLIC_API_URL=https://api.example.com

# Timeout de axios en ms (default del codigo: 10000).
NEXT_PUBLIC_API_TIMEOUT=10000

# true fuerza autenticacion mock aunque haya API URL. Jamas en prod.
NEXT_PUBLIC_MOCK_AUTH=false

# RECORDATORIO cross-repo: anadir el origen publico de este front a STORE_CORS
# y AUTH_CORS en el .env del backend.
