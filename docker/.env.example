# =============================================================================
# Plantilla de .env para docker/compose.yml. SOLO placeholders.
#   DESPLIEGUE: /opt/projects/marketplace-b2b-carrefour-frontend/.env (chmod 600)
#   En local el front corre en el host (npm run dev), no en Docker.
#
# La configuracion de la app (NEXT_PUBLIC_*) NO va aqui: se hornea en la imagen
# desde las vars del GitHub Environment (docs/DEPLOYMENT.md). Este .env solo
# dice QUE imagen y en QUE puerto.
# =============================================================================

# Imagen a desplegar. deploy.yml la actualiza con sed en cada despliegue.
IMAGE_FRONT=ghcr.io/abacus-consulting-tech/marketplace-b2b-carrefour-frontend:pre-0000000

# Puerto en 127.0.0.1 del host al que apunta el nginx de Plesk (app -> 3000).
# deploy.yml lo sobrescribe con la var FRONT_PUBLISH_PORT del environment.
FRONT_PUBLISH_PORT=10110
