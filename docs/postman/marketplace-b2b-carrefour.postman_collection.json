    {
      "name": "3 - Admin",
      "item": [
        {
          "name": "POST /auth/user/emailpass (save jwtToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const token = body.token || body.access_token || body.jwt || '';",
                  "if (token) {",
                  "  pm.collectionVariables.set('jwtToken', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/emailpass",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "emailpass"
              ]
            },
            "description": "If your backend auth flow is enabled for this endpoint, this request stores the returned token in {{jwtToken}} automatically."
          },
          "response": []
        },
        {
          "name": "POST /admin/api-keys (create publishable key)",
          "request": {
            "method": "POST",
