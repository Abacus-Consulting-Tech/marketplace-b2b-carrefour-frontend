                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"frontend-dev\",\n  \"type\": \"publishable\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "api-keys"
              ]
            },
            "description": "Requires token from the operative admin account."
          },
          "response": []
        },
        {
          "name": "GET /admin/custom",
