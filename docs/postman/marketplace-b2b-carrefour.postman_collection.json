    {
      "name": "2 - Auth checks",
      "item": [
        {
          "name": "POST /auth/user/emailpass (admin operative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const token = body.token || body.access_token || body.jwt || '';",
                  "if (token) {",
                  "  pm.collectionVariables.set('jwtToken', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/emailpass",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "emailpass"
              ]
            },
            "description": "Stores token in {{jwtToken}} for admin requests."
          },
          "response": []
        },
        {
          "name": "POST /auth/user/emailpass (local replica admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{localAdminEmail}}\",\n  \"password\": \"{{localReplicaPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/emailpass",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "emailpass"
              ]
            },
            "description": "Validates replicated local admin credentials (auth only)."
          },
          "response": []
        },
        {
          "name": "POST /auth/user/emailpass (seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
