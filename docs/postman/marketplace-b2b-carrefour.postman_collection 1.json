        {
          "name": "GET /store/shipping-options?cart_id={cartId}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const grouped = body.shipping_options || {};",
                  "const groups = Object.keys(grouped);",
                  "if (!groups.length) return;",
                  "const firstGroup = grouped[groups[0]] || [];",
                  "const first = firstGroup[0];",
                  "if (first && first.id) pm.collectionVariables.set('shippingOptionId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
