    "manualCreation": {
      "description": "Crea pedidos manualmente usando la API de Medusa",
      "steps": [
        "1. Autenticarse como admin (POST /auth/user/emailpass)",
        "2. Obtener lista de productos (GET /store/products)",
        "3. Crear carrito (POST /store/carts) con region_id y shipping_address",
        "4. Agregar items al carrito (POST /store/carts/{id}/line-items) con variant_id y quantity",
        "5. Completar carrito para crear orden (POST /store/carts/{id}/complete)"
      ]
    }
